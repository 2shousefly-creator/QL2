# WEB MỚI (build:web/start:web): chỉ cần PORT và NODE_ENV tại runtime.
# Không copy file này thành cấu hình quanloweb nếu chưa bỏ toàn bộ phần legacy.
# NODE_ENV=production
# PORT=8080
# BUILD_ID / BUILD_PUBLISHED_AT là metadata public tại BUILD, không phải secret.
# BUILD_ID=commit-sha-or-release-id
# BUILD_PUBLISHED_AT=2026-09-09T00:00:00.000Z
# Push máy chủ bị tắt trong build:web; không có biến runtime để tự bật/migrate.
# Không dùng VITE_* cho secret. Build web không đọc .env hoặc VITE_*.

# LEGACY ONLY — giữ tham chiếu cũ, KHÔNG áp dụng cho service quan-lo-web.
# Chưa tìm thấy lời gọi GenAI trong source HEAD; dependency vẫn được giữ.
# Nếu thêm AI API sau này: secret runtime qua Secret Manager, adapter server có auth/quota.
GEMINI_API_KEY=

# APP_URL: The URL of the fixed Web Push backend on Cloud Run.
APP_URL="https://quan-lo-push-api-953163983006.asia-southeast1.run.app"

# GOOGLE CLOUD CONFIGURATION
GOOGLE_CLOUD_PROJECT="gen-lang-client-0052121673"
CLOUD_TASKS_LOCATION="asia-southeast1"
CLOUD_TASKS_QUEUE="xp-full-push"
CLOUD_TASKS_SERVICE_ACCOUNT_EMAIL="quan-lo-task-invoker@gen-lang-client-0052121673.iam.gserviceaccount.com"

# WEB PUSH VAPID CONFIGURATION
# Production VAPID private key MUST be pinned to version 1: quan-lo-vapid-private-key:1
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT="mailto:admin@quan-lo.app"

# OPTIONAL DEV TOGGLE (Defaults to false in production)
# Set to "true" only in local dev without GCP credentials to allow memory store
ALLOW_IN_MEMORY_PUSH_FALLBACK=false
